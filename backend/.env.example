# 복사해서 .env 로 저장한다. .env 는 커밋하지 않는다.

APP_ENV=dev
ENABLE_DOCS=true
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/issues
STORAGE_DIR=storage
# 업로드 음성 최대 크기(MB)
MAX_UPLOAD_MB=25

# 자리표시 값. dev 에서는 경고만 하고, 그 외 환경에서는 서버가 시작되지 않는다.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
# 비우면 APP_ENV != dev 일 때 Secure 쿠키
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/auth

# 데모 계정 비밀번호. 코드에 넣지 않는다.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR1_PASSWORD=
SEED_OPERATOR2_PASSWORD=
SEED_OPERATOR3_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_OPERATOR1_USERNAME=operator1
SEED_OPERATOR2_USERNAME=operator2
SEED_OPERATOR3_USERNAME=operator3

# 고려대 FactChat 게이트웨이. Claude, GPT, Jev, STT 가 키 하나를 같이 쓴다.
# 키는 서버 안에서만 쓰고, 응답과 프론트에 넣지 않는다. 이 파일에 실제 키를 적지 않는다.
GATEWAY_BASE_URL=https://factchat.mindlogic-kr-api.com/v1/gateway
GATEWAY_API_KEY=
GATEWAY_TIMEOUT_SECONDS=120
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BACKOFF_SECONDS=0.5
# 사실 추출 chat/completions 모델. 비우면 CLAUDE_MODEL 을 쓴다.
EXTRACT_MODEL=claude-opus-5-5
# 예전 이름. EXTRACT_MODEL 이 있으면 쓰지 않는다.
CLAUDE_MODEL=
# 고정 버전. latest 는 거부한다.
JEV_MODEL_VERSION=jev-1.14.0

# mock 은 외부 호출이 없다. gateway 는 위 키로 실제 STT 를 호출한다.
STT_PROVIDER=mock
# stt-async-v5 또는 stt-async-v6. 기본은 v5.
STT_MODEL=stt-async-v5
STT_LANGUAGE=ko
STT_DIARIZATION=true
# 짧은 녹음은 수 초면 끝난다. 공개 문서는 긴 오디오에 10초 간격을 권장한다.
STT_POLL_INTERVAL_SECONDS=2
STT_POLL_TIMEOUT_SECONDS=300
# 게이트웨이 요청 본문 한도(MB). 업로드 한도와 별개다. wav 가 넘으면 더 작은 mp3 로 보낸다.
STT_MAX_AUDIO_MB=25
# Windows 에서 PATH 에 없으면 ffmpeg.exe 의 전체 경로를 넣는다.
FFMPEG_BIN=ffmpeg
# STT 전 잡음 제거(off | ffmpeg_afftdn | deepfilternet). 기본 off.
STT_DENOISE=off
STT_DENOISE_BIN=deepFilter

EXTRACTOR_PROVIDER=mock
CLASSIFIER_PROVIDER=mock

# 임시 임계값. tune 데이터로 보정 후 확정.
CLS_CONF_HIGH=0.85
CLS_CONF_LOW=0.55
STT_CONF_MIN=0.6
# 녹음 취소 의도("방금 거 취소해"). cancel 확률이 HIGH 이상이면 휴지통, LOW 이상이면 검토 필요.
CANCEL_INTENT_ENABLED=true
CANCEL_CONF_HIGH=0.85
CANCEL_CONF_LOW=0.5

# 명시 목록만. * 는 허용하지 않는다.
CORS_ORIGINS=http://localhost:5173
